# JagatData environment configuration
# Copy this file to .env and adjust values as needed

# SQLite database file (relative to backend/ working directory)
DATABASE_URL=jagatdata.db

# FastAPI backend base URL (used by Streamlit dashboard)
API_BASE_URL=http://127.0.0.1:8000

# n8n webhook URL for event-driven notifications
# Point this to your local/hosted n8n instance's webhook trigger
N8N_WEBHOOK_URL=http://localhost:5678/webhook/jagatdata-alerts

# Simple shared secret used for demo role-based auth tokens
# (NOT for production use — replace with OAuth2/OIDC + real IdP integration)
AUTH_SECRET=jagatdata-hackathon-secret

# Duplicate match thresholds
DUPLICATE_THRESHOLD=85
REVIEW_THRESHOLD=65
